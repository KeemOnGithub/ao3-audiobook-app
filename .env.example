# =====================================================================
# AO3 Audiobook TTS Environment Configuration Template
# =====================================================================

# Server Ports & Paths
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
DATABASE_PATH=./data/ao3_audiobook.db

# TTS Microservice & Active Remote Qwen3-TTS Endpoint
TTS_SERVICE_URL=http://localhost:8002
# Set to 'true' to run in mock mode (simulated audio, no GPU needed for local development)
TTS_USE_MOCK=false
# If TTS_USE_MOCK is false, set your remote Qwen-TTS serving endpoint base URL
REMOTE_TTS_URL=https://your-qwen-tts-endpoint-url
TTS_API_KEY=dummy
FFMPEG_BINARY=ffmpeg

# Text Model (LLM Script Deconstruction Service - OpenAI-compatible endpoint)
LLM_BASE_URL=https://example_url.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=glm-5.2
LLM_MAX_TOKENS=8192
